{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/q/:code",
      "destination": "/api/qr?code=:code"
    },
    {
      "source": "/m/:slug",
      "destination": "/index.html?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/waiters",
      "destination": "/admin-waiters.html"
    }
  ],
  "outputDirectory": "public"
}
